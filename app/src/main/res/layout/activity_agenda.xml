<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/agendaFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@drawable/manage_contacts_background">

        <TextView
            android:id="@+id/agendaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Agenda"
            android:textSize="18sp"
            android:textColor="#000"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </FrameLayout>

    <ListView
        android:id="@+id/agendaListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/agendaFrame"
        android:layout_above="@id/buttonLayout"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/white"
        android:divider="@android:color/darker_gray"
        android:choiceMode="multipleChoice"
        android:dividerHeight="1dp"
        tools:ignore="NotSibling" />

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/confirmSelectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Selection" />
    </LinearLayout>
</RelativeLayout>